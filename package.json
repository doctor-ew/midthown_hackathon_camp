{
  "name": "skippy-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda function running a LangChain OpenAI bot primed to answer questions like Skippy the Magnificent.",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/app.js",
    "dev": "ts-node src/app.ts",
    "lambda": "serverless offline",
    "test": "cross-env NODE_ENV=development ts-node test-local.ts",
    "test:security": "npm run build && node --test test/*.test.cjs && npm run test:deploy",
    "test:deploy": "python3 -m unittest discover -s test -p 'deploy*_test.py' && python3 -O -m unittest discover -s test -p 'deploy*_test.py'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1168.0",
    "@aws-sdk/client-lambda": "3.1168.0",
    "@aws-sdk/lib-dynamodb": "3.1168.0",
    "@langchain/core": "0.2.7",
    "@langchain/openai": "^0.1.3",
    "axios": "^0.21.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "langchain": "0.2.5",
    "serverless-dotenv-plugin": "^6.0.0"
  },
  "resolutions": {
    "@langchain/core": "0.2.7"
  },
  "overrides": {
    "@langchain/core": "0.2.7"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "0.2.7"
    }
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^4.17.25",
    "@types/node": "^14.18.63",
    "cross-env": "^7.0.3",
    "esbuild": "0.28.2",
    "serverless-domain-manager": "^7.3.8",
    "serverless-offline": "^13.6.0",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "author": "Your Name",
  "license": "MIT"
}
